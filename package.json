{
  "name": "react-native-meowui",
  "version": "0.4.0",
  "description": "Soft retro instruments pressed in cream and ink — a zero-dependency UI kit for React Native.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.commonjs.json && tsc -p tsconfig.module.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "ui-kit",
    "design-system",
    "meowui",
    "typescript",
    "android",
    "ios"
  ],
  "author": "Vidura Fernando",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heymeowcat/react-native-meowui"
  },
  "bugs": {
    "url": "https://github.com/heymeowcat/react-native-meowui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-native": "^0.88.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
